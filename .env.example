# Copy this file to `.env` and fill in your real exchange API credentials.
# `.env` is git-ignored — NEVER commit real keys.
#
# These are only required for LIVE trading (config: trading.dry_run = false).
# In dry_run mode they are optional; public market data needs no auth.

EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Some exchanges (e.g. coinbase, kucoin, okx) also require a passphrase:
# EXCHANGE_API_PASSWORD=
