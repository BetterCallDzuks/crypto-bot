# Copy this file to `.env` and fill in your real exchange API credentials.
# `.env` is git-ignored — NEVER commit real keys.
#
# These are only required for LIVE trading (config: trading.dry_run = false).
# In dry_run mode they are optional; public market data needs no auth.

EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Some exchanges (e.g. coinbase, kucoin, okx) also require a passphrase:
# EXCHANGE_API_PASSWORD=

# --- Dashboard login --------------------------------------------------------
# Set DASHBOARD_PASSWORD to require a login for the web dashboard. It is hashed
# in memory and never stored in plaintext. REQUIRED before exposing the
# dashboard beyond localhost (e.g. over Tailscale) — the bot refuses to bind to
# a non-local address without it.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Optional: a fixed session-signing key so logins survive restarts. If unset,
# a random one is generated each run (you'll be logged out on restart).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
